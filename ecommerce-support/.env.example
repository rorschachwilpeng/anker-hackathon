OPENAI_BASE_URL=https://example.invalid/v1
OPENAI_MODEL=your-model-name
OPENAI_API_KEY=replace-me
CONTEXT_WINDOW_TOKENS=8192
MAX_OUTPUT_TOKENS=512
CONTEXT_MARGIN_TOKENS=256
REQUEST_TIMEOUT=60
STRUCTURED_OUTPUT_METHOD=json_mode
# 本地 MySQL：替换为随机密码，DATABASE_URL 中密码须与 MYSQL_PASSWORD 一致。
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_PASSWORD=replace-with-random-app-password
DATABASE_URL=mysql+aiomysql://support:replace-with-random-app-password@127.0.0.1:3307/ecommerce_support?charset=utf8mb4
TOOL_TIMEOUT=5

EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
MILVUS_URI=http://127.0.0.1:19530
