OPENAI_BASE_URL=https://example.invalid/v1
OPENAI_MODEL=your-model-name
OPENAI_API_KEY=replace-me
CONTEXT_WINDOW_TOKENS=8192
MAX_OUTPUT_TOKENS=512
CONTEXT_MARGIN_TOKENS=256
REQUEST_TIMEOUT=60
STRUCTURED_OUTPUT_METHOD=json_mode
# 本地 MySQL：替换为随机密码，DATABASE_URL 中密码须与 MYSQL_PASSWORD 一致。
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_PASSWORD=replace-with-random-app-password
DATABASE_URL=mysql+aiomysql://support:replace-with-random-app-password@127.0.0.1:3307/ecommerce_support?charset=utf8mb4
TOOL_TIMEOUT=5

EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
# 留空时复用 EMBEDDING_API_KEY；云端 BGE 重排使用同服务商端点。
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=
# 以 ch04 校准集确定，不能沿用旧 dense COSINE 阈值。
# RERANK_SCORE_THRESHOLD=0.5
MILVUS_URI=http://127.0.0.1:19530
KNOWLEDGE_TOP_K=5
KNOWLEDGE_TOOL_TIMEOUT=20
KNOWLEDGE_WORKER_ENABLED=false
KNOWLEDGE_WORKER_TIMEZONE=Asia/Shanghai
KNOWLEDGE_EXTRACTION_MAX_TOKENS=4096
# Calibrated on evals/ch03/calibration.jsonl; validate again when knowledge or embedding config changes.
KNOWLEDGE_SCORE_THRESHOLD=0.5703911052474976

MINIO_ROOT_USER=replace-with-local-user
MINIO_ROOT_PASSWORD=replace-with-local-password
